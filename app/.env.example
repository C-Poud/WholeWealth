# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Application secret (used for JWT session signing) — REQUIRED

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db) — REQUIRED

# ── Google OAuth (optional) ─────────────────────────────────────
# When both are set, users must sign in with Google.
# When unset, the app runs as an open single-workspace (no login).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: https://<your-domain>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SnapTrade (optional) ────────────────────────────────────────
# Can also be entered later in the app's Settings page.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ── Kimi platform (only used when deployed on kimi.com) ─────────
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
